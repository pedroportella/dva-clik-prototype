{
  "name": "dva-clik-operations-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project=chromium --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "PWDEBUG=1 playwright test --project=chromium --workers=1",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:e2e:mock": "E2E_USE_MOCK=true playwright test",
    "test:e2e:real": "E2E_USE_MOCK=false E2E_CLEANUP_RECORDS=true playwright test --project=chromium --workers=1",
    "test:e2e:real:headed": "E2E_USE_MOCK=false E2E_CLEANUP_RECORDS=true playwright test --headed --project=chromium --workers=1",
    "test:e2e:real:keep-records": "E2E_USE_MOCK=false E2E_CLEANUP_RECORDS=false playwright test --project=chromium --workers=1"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "pinia": "^2.3.1",
    "sass": "^1.83.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^18.19.74",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^1.6.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@10.18.3"
}
